[Desktop Entry]
Type=Application
Version=1.0
Name=hublot
GenericName=Docker Monitor
GenericName[fr]=Moniteur Docker
Comment=Watch and manage the local Docker daemon
Comment[fr]=Surveiller et piloter le démon Docker local
Icon=hublot
Exec=hublot
# hublot is a terminal program, so the desktop file asks for a terminal the way
# htop's does. Without this the launcher starts it with no tty and it exits.
Terminal=true
Categories=System;Monitor;ConsoleOnly;
Keywords=docker;container;compose;monitor;prune;disk;
Keywords[fr]=docker;conteneur;compose;surveillance;disque;
